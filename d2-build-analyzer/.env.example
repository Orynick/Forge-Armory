# Copiez ce fichier en .env.local et remplissez avec les valeurs obtenues
# sur https://www.bungie.net/en/Application (app de type "Public / Confidential Client: No")
#
# .env.local est ignoré par git (voir .gitignore) : ne partagez jamais ce fichier.

VITE_BUNGIE_API_KEY=
VITE_BUNGIE_CLIENT_ID=
# Bungie exige HTTPS et refuse "localhost" : utilisez 127.0.0.1 (voir README).
VITE_BUNGIE_REDIRECT_URI=https://127.0.0.1:5173/auth/callback
