# FICHIER MODELE - ne le remplissez pas directement.
# Faites-en une copie nommee .env.local (dans ce meme dossier), puis
# remplissez la copie avec les valeurs de VOTRE application Bungie.
#
# Pas a pas complet (debutants bienvenus) : README.md, section
# "Creer votre propre application Bungie".
#
# Dans le Bloc-notes : Fichier > Enregistrer sous..., Type = "Tous les
# fichiers (*.*)", Nom = .env.local  (et surtout pas .env.local.txt).
#
# Collez vos valeurs juste apres le signe =, sans espace ni guillemets.
# .env.local est ignore par git (voir .gitignore) : ne le partagez pas.

VITE_BUNGIE_API_KEY=
VITE_BUNGIE_CLIENT_ID=
# Ne pas modifier : Bungie exige HTTPS et refuse "localhost".
VITE_BUNGIE_REDIRECT_URI=https://127.0.0.1:5173/auth/callback
